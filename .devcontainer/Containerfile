# Pinned by digest (the multi-arch index), like the baseline environment's
# base image: a tag moves under you, a digest does not. Refresh with
# `skopeo inspect --format '{{.Digest}}' docker://registry.fedoraproject.org/fedora:44`.
FROM registry.fedoraproject.org/fedora:44@sha256:125c2106ffaa3b2035c5bb480355c6bee73f723bfab47012bb29269d97ec61e4

RUN dnf install -y \
    gcc gcc-c++ make cmake perl pkgconf-pkg-config \
    rust cargo clippy rustfmt rust-analyzer \
    gtk4-devel libadwaita-devel gtksourceview5-devel vte291-gtk4-devel \
    webkitgtk6.0-devel \
    git openssl-devel libssh2-devel libgit2-devel \
    desktop-file-utils libappstream-glib \
    nodejs npm bubblewrap python3 socat bash-completion \
    default-fonts-core-sans default-fonts-core-mono default-fonts-core-emoji \
    adwaita-icon-theme adwaita-icon-theme-legacy \
    mesa-dri-drivers mesa-libEGL mesa-vulkan-drivers libglvnd-egl \
    dbus-daemon dbus-tools \
    xorg-x11-server-Xvfb optipng \
    gstreamer1-devel gstreamer1-plugins-base-devel gstreamer1-plugins-good \
    pipewire-gstreamer clang-devel \
    && dnf clean all

# The portal stack cannot work in here (no fuse, no PipeWire) and only
# produces startup noise when GTK asks for the color scheme. Removing the
# D-Bus activation files makes portals cleanly absent, so libadwaita falls
# back silently (the bootstrap forwards the host color scheme via
# ADW_DEBUG_COLOR_SCHEME instead).
RUN rm -f /usr/share/dbus-1/services/org.freedesktop.portal.*.service \
    /usr/share/dbus-1/services/org.freedesktop.impl.portal.*.service

# Task, at the version the IDE brings into every environment
# (`taste_core::tasks::IDE_TASK_VERSION` and its sums, which a test holds
# this line to): `taste-taskfile`'s reader is checked against it, so the
# gate needs it here. Fedora's go-task is whatever version Fedora ships.
ARG TASK_VERSION=3.54.0
RUN case "$(uname -m)" in \
      x86_64) arch=amd64 sum=680859dbb4d881a9c72d4d9a8f510825450849af8567deacd7302c01124416fb ;; \
      aarch64) arch=arm64 sum=d7189d439d4a6058e39e1b2acd7c8b27acd4856691b408f23b242e4294e1df5b ;; \
      *) echo "no Task for $(uname -m)" >&2; exit 1 ;; \
    esac && \
    curl -fsSL -o /tmp/task.tar.gz \
      "https://github.com/go-task/task/releases/download/v${TASK_VERSION}/task_linux_${arch}.tar.gz" && \
    echo "$sum  /tmp/task.tar.gz" | sha256sum -c --quiet - && \
    tar -xzf /tmp/task.tar.gz -C /usr/local/bin task && \
    rm /tmp/task.tar.gz

# Rootless podman with --userns=keep-id maps the host user onto this uid.
RUN useradd --uid 1000 --create-home dev
USER dev
WORKDIR /workspaces/taste-ide
