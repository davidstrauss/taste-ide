{
  "name": "taste-ide",
  "build": {
    "dockerfile": "Containerfile"
  },
  "containerUser": "dev",
  "workspaceFolder": "/workspaces/taste-ide",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/taste-ide,type=bind,Z",
  "mounts": [
    "source=taste-ide-cargo,target=/home/dev/.cargo,type=volume"
  ],
  "remoteEnv": {
    "CARGO_TERM_COLOR": "always"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer"
      ]
    }
  }
}
