<?xml version="1.0" encoding="UTF-8"?>
<!--
  Typst (https://typst.app) for GtkSourceView, which ships no definition of
  its own (David, 2026-10-05: "Can I get syntax highlighting for .typ?").
  Markup by default; code after `#`, in `#{ … }` blocks, and in a call's
  arguments; content blocks `[ … ]` inside code are markup again; math
  between dollars. The app registers it with the language manager at
  startup (crates/taste-app/src/main.rs).
-->
<language id="typst" name="Typst" version="2.0" _section="Markup">
  <metadata>
    <property name="mimetypes">text/x-typst</property>
    <property name="globs">*.typ</property>
    <property name="line-comment-start">//</property>
    <property name="block-comment-start">/*</property>
    <property name="block-comment-end">*/</property>
  </metadata>

  <styles>
    <style id="comment" name="Comment" map-to="def:comment"/>
    <style id="heading" name="Heading" map-to="def:heading"/>
    <style id="strong" name="Strong" map-to="def:strong-emphasis"/>
    <style id="emphasis" name="Emphasis" map-to="def:emphasis"/>
    <style id="raw" name="Raw" map-to="def:inline-code"/>
    <style id="math" name="Math" map-to="def:special-constant"/>
    <style id="list-marker" name="List Marker" map-to="def:list-marker"/>
    <style id="label" name="Label" map-to="def:link-text"/>
    <style id="reference" name="Reference" map-to="def:link-text"/>
    <style id="url" name="URL" map-to="def:link-destination"/>
    <style id="escape" name="Escape" map-to="def:special-char"/>
    <style id="keyword" name="Keyword" map-to="def:keyword"/>
    <style id="function" name="Function" map-to="def:function"/>
    <style id="string" name="String" map-to="def:string"/>
    <style id="number" name="Number" map-to="def:number"/>
    <style id="constant" name="Constant" map-to="def:special-constant"/>
    <style id="operator" name="Operator" map-to="def:operator"/>
  </styles>

  <definitions>
    <context id="line-comment" style-ref="comment" end-at-line-end="true" class="comment" class-disabled="no-spell-check">
      <start>//</start>
    </context>

    <context id="block-comment" style-ref="comment" class="comment" class-disabled="no-spell-check">
      <start>/\*</start>
      <end>\*/</end>
      <include>
        <context ref="block-comment"/>
      </include>
    </context>

    <context id="escape" style-ref="escape">
      <match>\\(u\{[0-9A-Fa-f]+\}|[^\s])</match>
    </context>

    <context id="string" style-ref="string" class="string" class-disabled="no-spell-check">
      <start>"</start>
      <end>"</end>
      <include>
        <context ref="escape"/>
      </include>
    </context>

    <context id="raw-block" style-ref="raw" class="no-spell-check">
      <start>```</start>
      <end>```</end>
    </context>

    <context id="raw-inline" style-ref="raw" class="no-spell-check">
      <start>`</start>
      <end>`</end>
    </context>

    <context id="math" style-ref="math" class="no-spell-check">
      <start>\$</start>
      <end>\$</end>
      <include>
        <context ref="escape"/>
        <context ref="line-comment"/>
        <context ref="block-comment"/>
      </include>
    </context>

    <context id="number" style-ref="number">
      <match>(?&lt;![\w.])\d+(\.\d+)?(pt|mm|cm|in|em|fr|deg|rad|%)?(?![\w])</match>
    </context>

    <context id="constant" style-ref="constant">
      <keyword>none</keyword>
      <keyword>auto</keyword>
      <keyword>true</keyword>
      <keyword>false</keyword>
    </context>

    <context id="code-keyword" style-ref="keyword">
      <keyword>let</keyword>
      <keyword>set</keyword>
      <keyword>show</keyword>
      <keyword>import</keyword>
      <keyword>include</keyword>
      <keyword>if</keyword>
      <keyword>else</keyword>
      <keyword>for</keyword>
      <keyword>in</keyword>
      <keyword>while</keyword>
      <keyword>break</keyword>
      <keyword>continue</keyword>
      <keyword>return</keyword>
      <keyword>and</keyword>
      <keyword>or</keyword>
      <keyword>not</keyword>
      <keyword>as</keyword>
      <keyword>context</keyword>
      <keyword>where</keyword>
    </context>

    <context id="call-name" style-ref="function">
      <match>\b[A-Za-z_][\w-]*(?=\()</match>
    </context>

    <context id="operator" style-ref="operator">
      <match>=&gt;|==|!=|&lt;=|&gt;=|\+=|-=|\*=|/=|\.\.</match>
    </context>

    <!-- Code: inside #{ … }, inside a call's parentheses, and nested. -->
    <context id="code">
      <include>
        <context ref="line-comment"/>
        <context ref="block-comment"/>
        <context ref="string"/>
        <context ref="raw-inline"/>
        <context ref="number"/>
        <context ref="constant"/>
        <context ref="code-keyword"/>
        <context ref="call-name"/>
        <context ref="operator"/>
        <context id="code-braces">
          <start>\{</start>
          <end>\}</end>
          <include>
            <context ref="code"/>
          </include>
        </context>
        <context id="code-parens">
          <start>\(</start>
          <end>\)</end>
          <include>
            <context ref="code"/>
          </include>
        </context>
        <context id="content-block">
          <start>\[</start>
          <end>\]</end>
          <include>
            <context ref="markup"/>
          </include>
        </context>
      </include>
    </context>

    <!-- `#` and what follows it: a keyword starts code that runs to the
         end of its line, or past it while a bracket it opened is open; a
         name, then its arguments. -->
    <context id="hash-keyword">
      <start>(#(let|set|show|import|include|if|else|for|while|return|break|continue|context))\b</start>
      <end>$</end>
      <include>
        <context sub-pattern="1" where="start" style-ref="keyword"/>
        <context ref="code"/>
      </include>
    </context>

    <context id="hash-block">
      <start>#\{</start>
      <end>\}</end>
      <include>
        <context ref="code"/>
      </include>
    </context>

    <context id="hash-call">
      <start>(#[A-Za-z_][\w-]*(\.[A-Za-z_][\w-]*)*)\(</start>
      <end>\)</end>
      <include>
        <context sub-pattern="1" where="start" style-ref="function"/>
        <context ref="code"/>
      </include>
    </context>

    <context id="hash-name" style-ref="function">
      <match>#[A-Za-z_][\w-]*(\.[A-Za-z_][\w-]*)*</match>
    </context>

    <context id="markup">
      <include>
        <context ref="line-comment"/>
        <context ref="block-comment"/>
        <context ref="escape"/>
        <context ref="raw-block"/>
        <context ref="raw-inline"/>
        <context ref="math"/>
        <context ref="hash-keyword"/>
        <context ref="hash-block"/>
        <context ref="hash-call"/>
        <context ref="hash-name"/>
        <context id="heading" style-ref="heading">
          <match>^\s*=+\s.*$</match>
        </context>
        <context id="list-marker" style-ref="list-marker">
          <match>^\s*([-+]|\d+\.)(?=\s)</match>
        </context>
        <context id="term" style-ref="list-marker">
          <match>^\s*/\s[^:\n]*:</match>
        </context>
        <context id="strong" style-ref="strong">
          <match>(?&lt;![\w*])\*[^*\n]+\*(?![\w*])</match>
        </context>
        <context id="emphasis" style-ref="emphasis">
          <match>(?&lt;![\w_])_[^_\n]+_(?![\w_])</match>
        </context>
        <context id="label" style-ref="label">
          <match>&lt;[\w\-:.]+&gt;</match>
        </context>
        <context id="reference" style-ref="reference">
          <match>(?&lt;![\w])@[\w\-:.]+</match>
        </context>
        <context id="url" style-ref="url">
          <match>https?://[^\s\)\]&gt;]+</match>
        </context>
      </include>
    </context>

    <context id="typst">
      <include>
        <context ref="markup"/>
      </include>
    </context>
  </definitions>
</language>
